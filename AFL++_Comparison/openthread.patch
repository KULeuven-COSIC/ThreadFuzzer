+#include <openthread/thread_ftd.h>
+#include <openthread/platform/alarm-milli.h>
+#include <openthread/platform/radio.h>
+
+#include <iostream>
+#include <vector>
+#include "fuzzer_platform.h"
+#include "common/code_utils.hpp"
+#include "common/time.hpp"
+
+#include "benign_packets/all_packets.h"
+
+enum DUTThreadState {
+    Leader,
+    LeaderAfterParentResponse,
+    LeaderAfterChildIdResponse,
+    LeaderAfterAddressSolicitResponse,
+    LastState,
+};
+
+void AdvanceTime(otInstance *aInstance, uint32_t aDuration)
+{
+    uint32_t time = otPlatAlarmMilliGetNow() + aDuration;
+
+    while (ot::TimeMilli(otPlatAlarmMilliGetNow()) <= ot::TimeMilli(time))
+    {
+        while (otTaskletsArePending(aInstance))
+        {
+            otTaskletsProcess(aInstance);
+        }
+
+        FuzzerPlatformProcess(aInstance);
+    }
+}
+
+bool SendBuffer(otInstance* instance, uint8_t* buf, size_t size) {
+    otRadioFrame frame;
+
+    memset(&frame, 0, sizeof(frame));
+    frame.mPsdu    = buf;
+    frame.mChannel = 11;
+    frame.mLength  = static_cast<uint8_t>(size);
+    otPlatRadioReceiveDone(instance, &frame, OT_ERROR_NONE);
+
+    return FuzzerPlatformResetWasRequested();
+}
+
+/*
+    Data has the following structure:
+    - 1 byte: State
+    - Rest: Fuzzed packet
+*/
+int FuzzerTestOneInput(const uint8_t *data, size_t data_size){
+    size_t total_size;
+    otInstance  *instance = nullptr;
+    otLinkModeConfig linkMode;
+    uint8_t     *fuzzed_buf = nullptr;
+    uint8_t      linkModeFlags;
+    uint8_t      state; // State to start fuzzing from
+    uint8_t     *header = mle_header;
+    size_t header_size = mle_header_size;
+    uint8_t     *footer = mle_footer;
+    size_t footer_size = mle_footer_size;
+
+    const otPanId panId = 0xdead;
+
+    if (data_size < 6) return -1;
+
+    /* Parse with the linkModeFlags */
+    linkModeFlags = data[0];
+
+    if (linkModeFlags > 0b111) return -1;
+    linkMode.mRxOnWhenIdle = linkModeFlags & 0b1; /* 1 - Rx always on, 0 - Rx off when idle*/
+    linkMode.mDeviceType = linkModeFlags & 0b10; /* 1 - FTD, 0 - MTD */
+    linkMode.mNetworkData = linkModeFlags & 0b100; /* 1 - requires full network data, 0 - otherwise */
+
+    if (linkMode.mDeviceType && !linkMode.mRxOnWhenIdle) return -1; /* That is not valid configuration. FTD should always have Rx ON. */
+
+    /* Parse the fuzzing state */
+    state = data[1];
+    if (state >= DUTThreadState::LastState) return -1;
+
+    data = data + 2; // Move the pointer to the real data
+    data_size -= 2;  // Adjust the size
+
+    switch(static_cast<int>(data[0])) {
+        case CMD_PARENT_REQUEST:
+            header = mle_parent_request_header;
+            header_size = mle_parent_request_header_size;
+            break;
+        case CMD_CHILD_ID_REQUEST:
+            header = mle_child_id_request_header;
+            header_size = mle_child_id_request_header_size;
+            break;
+        case 0x69: /* Address solicit*/
+            header = {};
+            footer = {};
+            header_size = 0;
+            footer_size = 0;
+            break;
+        case CMD_ADVERTISEMENT:
+            header = advertisement_2_header;
+            header_size = advertisement_2_header_size;
+            break;
+        case CMD_LINK_REQUEST:
+            header = mle_link_request_header;
+            header_size = mle_link_request_header_size;
+            break;
+        case CMD_DATA_REQUEST:
+            header = data_request_header;
+            header_size = data_request_header_size;
+            break;
+        case CMD_DATA_RESPONSE:
+            header = data_response_header;
+            header_size = data_response_header_size;
+            break;
+        case CMD_CHILD_UPDATE_REQUEST:
+            header = mle_child_update_request_header;
+            header_size = mle_child_update_request_header_size;
+            break;
+        case CMD_CHILD_UPDATE_RESPONSE:
+            header = mle_child_update_response_header;
+            header_size = mle_child_update_response_header_size;
+            break;
+    }
+
+    total_size = header_size + footer_size + data_size;
+    VerifyOrExit(total_size <= OT_RADIO_FRAME_MAX_SIZE);
+
+    /* Assemble and send the fuzzed packet */
+    fuzzed_buf = static_cast<uint8_t *>(malloc(total_size));
+
+    memcpy(
+        fuzzed_buf,
+        header,
+        header_size
+    );
+
+    memcpy(
+        fuzzed_buf + header_size,
+        data,
+        data_size
+    );
+
+    memcpy(
+        fuzzed_buf + header_size + data_size,
+        footer,
+        footer_size
+    );
+
+    FuzzerPlatformInit();
+
+    instance = otInstanceInitSingle();
+    IgnoreError(otThreadSetLinkMode(instance, linkMode));
+    IgnoreError(otLinkSetPanId(instance, panId));
+    IgnoreError(otIp6SetEnabled(instance, true));
+    IgnoreError(otThreadSetEnabled(instance, true));
+
+    // Become leader
+    IgnoreError(otThreadBecomeLeader(instance));
+    AdvanceTime(instance, 10000);
+
+    if (state == DUTThreadState::Leader) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+    }
+    
+    // Send a benign Parent request
+    VerifyOrExit(!SendBuffer(instance, mle_parent_request, mle_parent_request_size));
+    AdvanceTime(instance, 100); // Wait for Parent response
+
+    if (state == DUTThreadState::LeaderAfterParentResponse) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+    }
+
+    // Send a benign Child ID request
+    VerifyOrExit(!SendBuffer(instance, mle_child_id_request, mle_child_id_request_size));
+    AdvanceTime(instance, 100); // Wait for Child ID Response
+
+    if (state == DUTThreadState::LeaderAfterChildIdResponse) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+    }
+
+    // Send a benign Address Solicit
+    VerifyOrExit(!SendBuffer(instance, address_solicit, address_solicit_size));
+    AdvanceTime(instance, 100); // Wait for Address Solicit Response
+
+    if (state == DUTThreadState::LeaderAfterAddressSolicitResponse)
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+
+    AdvanceTime(instance, 10000); // Wait for some after-effects to appear
+
+exit:
+
+    if (fuzzed_buf != nullptr) {
+        free(fuzzed_buf);
+    }
+
+    if (instance != nullptr)
+    {
+        otInstanceFinalize(instance);
+    }
+
+    return 0;
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
+    return FuzzerTestOneInput(data, size);
+}
