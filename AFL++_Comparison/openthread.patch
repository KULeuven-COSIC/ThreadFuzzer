diff --git a/tests/improved_fuzz/universal_mle_fuzzer-1.cpp b/tests/improved_fuzz/universal_mle_fuzzer-1.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3aeb758d015ebf15f154a99a6f94d11356d372af
--- /dev/null
+++ b/tests/improved_fuzz/universal_mle_fuzzer-1.cpp
@@ -0,0 +1,202 @@
+#include <stdlib.h>
+#include <string.h>
+
+#include <openthread/instance.h>
+#include <openthread/ip6.h>
+#include <openthread/link.h>
+#include <openthread/tasklet.h>
+#include <openthread/thread.h>
+#include <openthread/thread_ftd.h>
+#include <openthread/platform/alarm-milli.h>
+#include <openthread/platform/radio.h>
+
+#include <iostream>
+#include <vector>
+#include "fuzzer_platform.h"
+#include "common/code_utils.hpp"
+#include "common/time.hpp"
+
+#include "benign_packets/all_packets.h"
+
+enum DUTThreadState {
+    DetachedAfterParentRequest,
+    DetachedAfterChildIDRequest,
+    Child,
+    ChildAfterAddressSolicit,
+    Router,
+    ChildAfterChildUpdateRequest,
+    LastState,
+};
+
+void AdvanceTime(otInstance *aInstance, uint32_t aDuration)
+{
+    uint32_t time = otPlatAlarmMilliGetNow() + aDuration;
+
+    while (ot::TimeMilli(otPlatAlarmMilliGetNow()) <= ot::TimeMilli(time))
+    {
+        while (otTaskletsArePending(aInstance))
+        {
+            otTaskletsProcess(aInstance);
+        }
+
+        FuzzerPlatformProcess(aInstance);
+    }
+}
+
+bool SendBuffer(otInstance* instance, uint8_t* buf, size_t size) {
+    otRadioFrame frame;
+    int ret = 0;
+
+    memset(&frame, 0, sizeof(frame));
+    frame.mPsdu    = buf;
+    frame.mChannel = 11;
+    frame.mLength  = static_cast<uint8_t>(size);
+    otPlatRadioReceiveDone(instance, &frame, OT_ERROR_NONE);
+    return FuzzerPlatformResetWasRequested();
+}
+
+/*
+    Data has the following structure:
+    - 1 byte: linkMode flags represented by 3 bits
+    - 1 byte: State
+    - Rest: Fuzzed packet
+*/
+int FuzzerTestOneInput(const uint8_t *data, size_t data_size){
+    size_t total_size;
+    otInstance  *instance = nullptr;
+    otLinkModeConfig linkMode;
+    uint8_t     *fuzzed_buf = nullptr;
+    uint8_t      linkModeFlags;
+    uint8_t      state; // State to start fuzzing from
+
+    const otPanId panId = 0xdead;
+
+    if (data_size < 6) return -1;
+
+    /* Parse with the linkModeFlags */
+    linkModeFlags = data[0];
+
+    if (linkModeFlags > 0b111) return -1;
+    linkMode.mRxOnWhenIdle = linkModeFlags & 0b1; /* 1 - Rx always on, 0 - Rx off when idle*/
+    linkMode.mDeviceType = linkModeFlags & 0b10; /* 1 - FTD, 0 - MTD */
+    linkMode.mNetworkData = linkModeFlags & 0b100; /* 1 - requires full network data, 0 - otherwise */
+
+    if (linkMode.mDeviceType && !linkMode.mRxOnWhenIdle) return -1; /* That is not valid configuration. FTD should always have Rx ON. */
+
+    /* Parse the fuzzing state */
+    state = data[1];
+    if (state >= DUTThreadState::LastState) return -1;
+
+    data = data + 2; // Move the pointer to the real data
+    data_size -= 2;  // Adjust the size
+
+    total_size = mle_header_size + mle_footer_size + data_size;
+    if (total_size > OT_RADIO_FRAME_MAX_SIZE) return -1;
+
+    /* Assemble and send the fuzzed packet */
+    fuzzed_buf = static_cast<uint8_t *>(malloc(total_size));
+
+    memcpy(
+        fuzzed_buf,
+        mle_header,
+        mle_header_size
+    );
+
+    memcpy(
+        fuzzed_buf + mle_header_size,
+        data,
+        data_size
+    );
+
+    memcpy(
+        fuzzed_buf + mle_header_size + data_size,
+        mle_footer,
+        mle_footer_size
+    );
+
+    FuzzerPlatformInit();
+
+    instance = otInstanceInitSingle();
+
+    IgnoreError(otThreadSetLinkMode(instance, linkMode));
+    IgnoreError(otLinkSetPanId(instance, panId));
+    IgnoreError(otIp6SetEnabled(instance, true));
+    IgnoreError(otThreadSetEnabled(instance, true));
+
+    linkMode = otThreadGetLinkMode(instance);
+
+    // Become child
+    IgnoreError(otThreadBecomeChild(instance));
+    AdvanceTime(instance, 1000); // Wait for Parent request
+
+    if (state == DUTThreadState::DetachedAfterParentRequest) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+        AdvanceTime(instance, 100); // Wait a bit
+    }
+
+    // Send a benign Parent response
+    VerifyOrExit(!SendBuffer(instance, mle_parent_response, mle_parent_response_size));
+    AdvanceTime(instance, 1000); // Wait for Child request
+
+    if (state == DUTThreadState::DetachedAfterChildIDRequest) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+        AdvanceTime(instance, 100); // Wait a bit
+    }
+
+    // Send a benign Child response and verify child role
+    VerifyOrExit(!SendBuffer(instance, mle_child_id_response, mle_child_id_response_size));
+    AdvanceTime(instance, 1000); // Wait until device becomes a child
+    VerifyOrExit(otThreadGetDeviceRole(instance) == otDeviceRole::OT_DEVICE_ROLE_CHILD); // Check that device is a child
+
+    if (state == DUTThreadState::Child) {
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+        AdvanceTime(instance, 100); // Wait a bit
+    }
+
+    if (state == DUTThreadState::ChildAfterChildUpdateRequest) {
+        /* Wait for Child Update Request to be sent */
+        int timeout = linkMode.mDeviceType ? 235000 : 230000;
+        AdvanceTime(instance, timeout);
+        VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+        AdvanceTime(instance, 100); // Wait a bit
+    }
+
+    if (linkMode.mDeviceType) {
+        /* If FTD, become router */
+        IgnoreError(otThreadBecomeRouter(instance));
+        AdvanceTime(instance, 1000); // Wait for Address Solicit
+
+        if (state == DUTThreadState::ChildAfterAddressSolicit) {
+            VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+            AdvanceTime(instance, 100); // Wait a bit
+        }
+
+        VerifyOrExit(!SendBuffer(instance, address_solicit_response, address_solicit_response_size));
+
+        AdvanceTime(instance, 1000); // Wait for the device to become a Router
+        VerifyOrExit(otThreadGetDeviceRole(instance) == OT_DEVICE_ROLE_ROUTER);
+
+        if (state == DUTThreadState::Router) {
+            VerifyOrExit(!SendBuffer(instance, fuzzed_buf, total_size));
+        }
+    }
+
+exit:
+
+    AdvanceTime(instance, 10000); // Wait for some after-effects to appear
+
+    if (fuzzed_buf != nullptr) {
+        free(fuzzed_buf);
+    }
+
+    if (instance != nullptr)
+    {
+        otInstanceFinalize(instance);
+    }
+
+    return 0;
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
+    return FuzzerTestOneInput(data, size);
+}
