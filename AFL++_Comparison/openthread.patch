diff --git a/tests/improved_fuzz/benign_packets/common.h b/tests/improved_fuzz/benign_packets/common.h
new file mode 100644
index 0000000000000000000000000000000000000000..063398b422792b68bb4d29a7c19b751bcb53ba36
--- /dev/null
+++ b/tests/improved_fuzz/benign_packets/common.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#define FRAME_CTRL_FIELD_STD 0x61, 0xdc
+#define WPAN_DST_16 0xff, 0xff // USED FOR BROADCAST
+#define WPAN_DST 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa
+#define PAN_ID 0xAD, 0xDE
+#define EXTENDED_SRC 0xfc, 0x95, 0xc8, 0xfc, 0x6b, 0x3d, 0x54, 0xba
+#define SRC_PORT_MLE 0x4D, 0x4C
+#define DST_PORT_MLE 0x4D, 0x4C
+#define IPHC_HEADER 0x7f, 0x3B
+#define UDP_HEADER_COMPRESSION 0xf0
+#define UDP_CS_FAKE 0x00, 0x00 /* Fake Checksum */
+#define AUX_SEC_HEADER(second_byte) 0x15, second_byte, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01
+#define MLE_SEC_SUITE 0x00
+#define FAKE_CS 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
+
+/* TLVs */
+#define TLV_SRC_ADDR 0x00, 0x02, 0xCC, 0x00
+#define TLV_LEADER_DATA 0x0b, 0x08, 0x21, 0xE8, 0x80, 0x5F, 0x40, 0xCF, 0xFF, 0x33
+#define TLV_NETWORK_DATA 0x0c, 0x06, 0x08, 0x04, 0x0b, 0x02, 0xf5, 0x9e
+#define TLV_RESPONSE 0x04, 0x08, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB
+#define TLV_ADDRESS_16 0x0a, 0x02, 0xCC, 0x01
+#define TLV_ROUTE_64 0x09, 0x0a, 0x6b, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x01
+#define TLV_VERSION 0x12, 0x02, 0x00, 0x04
+#define TLV_UNKNOWN_0x1B 0x1B, 0x02, 0x00, 0x81
+#define TLV_TIMESTAMP 0x16, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00
+#define TLV_MODE 0x01, 0x01, 0x0F
+
+/* COMMANDS */
+#define CMD_LINK_REQUEST 0x00
+#define CMD_ADVERTISEMENT 0x04
+#define CMD_DATA_REQUEST 0x07
+#define CMD_DATA_RESPONSE 0x08
+#define CMD_PARENT_REQUEST 0x09
+#define CMD_PARENT_RESPONSE 0x0a
+#define CMD_CHILD_ID_REQUEST 0x0b
+#define CMD_CHILD_ID_RESPONSE 0x0c
+#define CMD_CHILD_UPDATE_REQUEST 0x0d
+#define CMD_CHILD_UPDATE_RESPONSE 0x0e
+
+// GENERIC MLE HEADER AND FOOTER
+uint8_t mle_header[] = {
+    0x61, 0xdc, 0xd4, 
+    /* PAN ID */
+    0xad, 0xde,
+    /* WPAN DESTINATION */
+    0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+    /**/
+    0xfc, 0x95, 0xc8, 0xfc, 0x6b, 0x3d, 0x54, 0xba, 0x7f, 0x33, 0xf0,
+    0x4d, 0x4c, 0x4d, 0x4c, 0xbd, 0x30,
+    /* MLE Security Suite */ 0x00,
+    /* Auxiliary Security Header */ 0x15, 0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
+};
+constexpr size_t mle_header_size = sizeof(mle_header);
+
+uint8_t mle_footer[] = {
+    0x00, 0x00, 0x00, 0x00,
+    /* FAKE CHECKSUM */ 0x00, 0x00
+};
+constexpr size_t mle_footer_size = sizeof(mle_footer);
\ No newline at end of file
